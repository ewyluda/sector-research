# Sector Research App — Environment Variables
# Copy to .env and fill in your values

FMP_API_KEY=
X_BEARER_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sector_research
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/sector_research

# Optional — FRED macro data (fed funds, CPI, GDP, etc.) skipped if empty
FRED_API_KEY=

# Optional overrides
FMP_BASE_URL=https://financialmodelingprep.com/stable
X_BASE_URL=https://api.twitter.com/2
LOG_LEVEL=INFO
